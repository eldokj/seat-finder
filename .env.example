# ============================================================================
# Exam Seat Finder — environment variables
# ============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit .env.local (it's already in .gitignore). In production
# (Vercel), set these as Project Environment Variables instead of a file.

# ----------------------------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------------------------
# From your Supabase project: Project Settings → API.

# Project URL. Safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key. Safe to expose to the browser (NEXT_PUBLIC_) — access is
# governed by Row Level Security, not by keeping this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SECRET — server-side only, never prefix with
# NEXT_PUBLIC_, never commit, never log, never return in an API response.
# Bypasses Row Level Security. Used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# College branding (optional — sensible placeholders are used if unset)
# ----------------------------------------------------------------------------
# All safe to expose to the browser. See src/lib/config/branding.ts.
# A future admin "Settings" page will move these into the database so staff
# can edit them without a redeploy; env vars remain the Phase 1 source.

NEXT_PUBLIC_COLLEGE_NAME="Your College Name"
NEXT_PUBLIC_COLLEGE_LOGO_URL=
NEXT_PUBLIC_COE_OFFICE_NAME="Controller of Examinations"
NEXT_PUBLIC_WEBSITE_TITLE="Exam Seat Finder"
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# IANA timezone used to decide "today" for exam scheduling (dashboard +
# student search both use this). Defaults to Asia/Kolkata if unset.
NEXT_PUBLIC_COLLEGE_TIMEZONE="Asia/Kolkata"
